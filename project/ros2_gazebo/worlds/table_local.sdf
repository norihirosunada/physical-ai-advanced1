<model name="wood_cube_5cm"><pose>0 -0.1 1.025 0 0 0</pose><link name="cube"><inertial><mass>0.05</mass><inertia><ixx>0.00002083</ixx><iyy>0.00002083</iyy><izz>0.00002083</izz></inertia></inertial><collision name="collision"><geometry><box><size>0.05 0.05 0.05</size></box></geometry></collision><visual name="visual"><geometry><box><size>0.05 0.05 0.05</size></box></geometry><material><diffuse>0.8 0.25 0.15 1</diffuse></material></visual></link></model>
