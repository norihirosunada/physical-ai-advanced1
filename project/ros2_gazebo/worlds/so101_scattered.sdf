            <box>
              <size>0.09 0.08 0.002</size>
            </box>
          </geometry>
          <material>
            <diffuse>0.2 0.65 0.5 1</diffuse>
          </material>
        </visual>
      </link>
    </model>
    <model name="eraser">
      <pose>0.180906621186653 -0.005389607389814751 1.013 0 0 0.1811213676478245</pose>
      <link name="body">
        <inertial>
          <mass>0.012</mass>
          <inertia>
            <ixx>1.1600000000000001e-06</ixx>
            <iyy>1.1600000000000001e-06</iyy>
            <izz>9.679999999999999e-07</izz>
          </inertia>
        </inertial>
        <collision name="collision">
          <geometry>
            <box>
              <size>0.022 0.022 0.026</size>
