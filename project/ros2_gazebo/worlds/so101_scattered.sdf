    <model name="overhead_camera">
      <static>true</static>
      <pose>.195 .015 1.65 0 1.5707963267948966 0</pose>
      <link name="camera_link">
        <sensor name="rgb" type="camera">
          <always_on>true</always_on>
          <update_rate>5</update_rate>
          <topic>/art_materials/camera</topic>
          <camera>
            <horizontal_fov>0.8</horizontal_fov>
            <image>
              <width>640</width>
              <height>480</height>
              <format>R8G8B8</format>
            </image>
            <clip>
              <near>0.05</near>
              <far>3</far>
            </clip>
          </camera>
        </sensor>
      </link>
