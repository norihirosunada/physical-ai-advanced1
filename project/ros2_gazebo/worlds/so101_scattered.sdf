          </geometry>
          <material>
            <diffuse>0.75 0.65 0.5 1</diffuse>
          </material>
        </visual>
      </link>
    </model>
    <model name="receiving_tray">
      <static>true</static>
      <pose>0.18 -0.10 1.001 0 0 0</pose>
      <link name="tray">
